{
  "name": "Review",
  "type": "object",
  "properties": {
    "place_id": {
      "type": "string"
    },
    "place_name": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "content": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    }
  },
  "required": [
    "place_id",
    "rating",
    "content"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
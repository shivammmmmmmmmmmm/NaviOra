{
  "name": "Checkpoint",
  "type": "object",
  "properties": {
    "trip_id": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "title": {
      "type": "string"
    },
    "place_name": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "expected_time": {
      "type": "string",
      "format": "date-time"
    },
    "expected_duration_minutes": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reached",
        "missed",
        "skipped"
      ],
      "default": "pending"
    },
    "actual_time": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "trip_id",
    "title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
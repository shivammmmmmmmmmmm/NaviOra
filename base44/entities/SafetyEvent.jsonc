{
  "name": "SafetyEvent",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "sos_activated",
        "sos_cancelled",
        "checkin_safe",
        "checkin_help",
        "location_shared",
        "location_stopped",
        "safety_mode_on",
        "safety_mode_off"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "info"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "resolved",
        "dismissed"
      ],
      "default": "active"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "event_type"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}